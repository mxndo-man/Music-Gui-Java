<project>
  <!-- If any changes where to be made to the depedencies please refer to the link below -->
  <!-- https://openjfx.io/openjfx-docs/maven -->
  <modelVersion>4.0.0</modelVersion>

  <!-- This defines the project, group and version-->
  <groupId>musicgui</groupId>
  <artifactId>musicGui</artifactId>
  <version>0.1</version>
  <packaging>jar</packaging>


  <!--  A global setting which sets java to version 21, UTF-8. -->
  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <javafx.version>21.0.5</javafx.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-media</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <!-- Work in Progress, this should allow us to get the .env for spotrify api. -->
    <dependency>
      <groupId>io.github.cdimascio</groupId>
      <artifactId>dotenv-java</artifactId>
      <version>3.2.0</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- Allows us to start the app with this command: mvn javafx:run, similar to cmake-->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>app.Main</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
